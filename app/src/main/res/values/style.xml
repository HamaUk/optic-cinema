<resources>

    <style name="AppTheme.Widget.BottomNav.Indicator" parent="">
        <item name="android:color">@color/colorPrimary</item>
        <item name="android:width">80dp</item>
        <item name="android:height">40dp</item>
        <item name="marginHorizontal">12dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="AppTheme.Widget.Tv.Button" parent="AppTheme.Tv">
        <item name="android:background">@drawable/bg_button_tv</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@drawable/color_button_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button" parent="AppTheme.Mobile">
        <item name="android:background">@drawable/bg_button_mobile</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Secondary" parent="AppTheme.Widget.Mobile.Button">
        <item name="android:background">@drawable/bg_button_secondary_mobile</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Stile per forzare il fondo nero nelle schermate di impostazione (Leanback) -->
    <!-- Usiamo direttamente android:background nella preferenceTheme per non romper il build -->
    <style name="PreferenceThemeOverlay.Leanback.Amoled" parent="PreferenceThemeOverlayLeanback">
        <item name="android:windowBackground">?attr/app_background_color</item>
        <item name="android:colorBackground">?attr/app_background_color</item>
    </style>

</resources>
